{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": ["chrome", "node"]
  },
  "include": [
    "src/**/*",
    "entrypoints/**/*",
    "tests/**/*",
    "scripts/**/*",
    ".wxt/types/**/*"
  ]
}
